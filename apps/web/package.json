    "@fontsource-variable/geist": "5.3.0",
    "@tanstack/react-query": "5.101.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "12.4.0",
    "katex": "0.18.4",
    "lucide-react": "1.31.0",
    "mermaid": "11.16.1",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "10.1.0",
    "react-router-dom": "7.18.2",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "shadcn": "4.18.0",

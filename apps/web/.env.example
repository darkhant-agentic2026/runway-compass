# Build-time configuration for the SPA. Vite inlines anything prefixed VITE_.
#
# All of these are PUBLIC by design: the security boundary is Identity Platform's
# authorized-domains list plus server-side token verification, not secrecy of the API key
# (docs/07-infra-deploy.md#github-actions).

# `dev` uses a `dev:<uid>` token, which the API accepts only when ENV=local. This is what
# ./scripts/dev.sh up and the Playwright suite run with.
VITE_AUTH_MODE=dev
VITE_DEV_UID=u_dev

# Deployed environments only. Supplied as Docker build args from Terraform outputs.
# VITE_AUTH_MODE=identity-platform
# VITE_IDENTITY_API_KEY=
# VITE_IDENTITY_AUTH_DOMAIN=
# VITE_IDENTITY_PROJECT_ID=

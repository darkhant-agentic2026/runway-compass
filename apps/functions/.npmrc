# save-exact: matches apps/web's .npmrc (CLAUDE.md: pin all dependencies).
save-exact=true

# legacy-peer-deps: `firebase-functions`'s optional peers (@apollo/server,
# @as-integrations/express4, graphql) crash npm 10's arborist while building the peer
# set — "Cannot read properties of null (reading 'edgesOut')" — even though none of them
# are actually needed here. This is an npm bug in peer-set resolution, not a real conflict:
# the one required peer, firebase-admin, is an explicit direct dependency below and is
# satisfied normally.
legacy-peer-deps=true

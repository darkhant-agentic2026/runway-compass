# The `.env` contract from docs/07-infra-deploy.md#local-development.
# Every value is validated at startup by the Pydantic `Settings` model, fail-fast.
#
# Copy to `.env.local` for local development. `./scripts/dev.sh up` sets ENV,
# GOOGLE_CLOUD_PROJECT, and FIRESTORE_EMULATOR_HOST itself, so a local developer needs
# nothing here unless they want the Gemini API backend.

ENV=local                                     # local | dev | prod
GOOGLE_CLOUD_PROJECT=demo-coach-local

MODEL_BACKEND=vertex                          # vertex | gemini_api
MODEL_NAME=gemini-3.7-flash
VERTEX_LOCATION=us-central1
# Required iff MODEL_BACKEND=gemini_api. Production uses Vertex AI and has no key.
# GEMINI_API_KEY=

FIRESTORE_DATABASE=(default)
# Local ONLY. `Settings` refuses to start when this is set with a non-local ENV — a
# deployed revision pointing at an emulator reads and writes nothing, silently.
FIRESTORE_EMULATOR_HOST=127.0.0.1:8081
# Pinned explicitly rather than left to the ADK default (docs/02-data-model.md).
ADK_FIRESTORE_ROOT_COLLECTION=adk-session

# Required when ENV is dev or prod; unused locally.
# ARTIFACT_BUCKET=coach-dev-coach-artifacts
# UPLOAD_BUCKET=coach-dev-coach-uploads
# TASKS_QUEUE=projects/coach-dev/locations/us-central1/queues/autonomous-runs
# TASKS_TARGET_URL=https://coach-api-....run.app/internal/runs
# TASKS_INVOKER_SA=coach-tasks-sa@coach-dev.iam.gserviceaccount.com
# YOUTUBE_API_KEY=sm://youtube-api-key

# /internal/tick and /internal/runs/* are invoked by TWO DIFFERENT service accounts, so
# OIDC verification allow-lists them separately. Collapsing these into one variable would
# mean either Cloud Scheduler could invoke the executor or the reverse.
# ALLOWED_SCHEDULER_SA=coach-scheduler-sa@coach-dev.iam.gserviceaccount.com
# ALLOWED_TASKS_SA=coach-tasks-sa@coach-dev.iam.gserviceaccount.com

# Identity Platform Google provider; also the token audience.
# OAUTH_CLIENT_ID=....apps.googleusercontent.com

LOG_LEVEL=INFO
